# Sealed backend configuration. Copy to .env and fill in. Never commit .env.
# `npm run dev` does NOT need this file: it generates throwaway local keys into .env.local.

# ---------------------------------------------------------------- chain
# 133 testnet, 177 mainnet, 31337 local anvil
CHAIN_ID=133
# mainnet: https://mainnet.hsk.xyz
HSK_RPC_URL=https://testnet.hsk.xyz
HSK_TESTNET_RPC_URL=https://testnet.hsk.xyz
# HSP-supported EIP-3009 stablecoin on the HashKey testnet (USDC, 6 decimals; HSP get_chain_config is the authority).
# The escrow already deployed on 133 (contracts/deployments/133.json, committed) uses it, so a teammate needs no redeploy.
PINNED_TOKEN=0x8FE3cB719Ee4410E236Cd6b72ab1fCDC06eF53c6
TOKEN_DECIMALS=6
# Filled from contracts/deployments/<chainId>.json after `npm run deploy`; env values override the file.
REGISTRY_ADDRESS=
ESCROW_ADDRESS=
VERIFIER_ADDRESS=
DEPLOY_BLOCK=
# eth_getLogs block range per request
LOGS_CHUNK=5000

# ---------------------------------------------------------------- keys (0x + 64 hex). Read from env only.
DEPLOYER_PRIVATE_KEY=
# calls SessionEscrow.markFunded
COORDINATOR_PRIVATE_KEY=
# sends MandateRegistry.seal / revoke
VAULT_PRIVATE_KEY=
# pays HSP (EIP-3009) and gas for SessionEscrow.open
BUYER_WALLET_PRIVATE_KEY=
SELLER_1_PRIVATE_KEY=
SELLER_2_PRIVATE_KEY=
ROGUE_PRIVATE_KEY=
# optional; defaults to the deployer
ESCROW_OWNER=

# ---------------------------------------------------------------- HSP Agentic Payment (the hackathon QA route, the default)
# Hosted MCP server: HSP keeps the App Key/Secret and the merchant key, so nothing secret is configured here.
# Before connecting, HSP must allowlist this machine's public egress IP (guide step 1). Test with: npm run hsp:check
# HSP_MODE=mcp                                   (default when HSP_LOCAL_STANDIN=0; "api" selects the signed Merchant API below)
# HSP_MCP_URL=https://mcp-qa.hashkeymerchant.com/
# The team's reporting name: spelled identically at create_order and query_payment, it decides post-event aggregation.
HSP_MERCHANT_NAME=Sealed
HSP_LOCAL_STANDIN=0
# The deployed token must be one of get_chain_config's tokens with payment_protocol eip3009 (testnet USDC 0x8FE3...53c6, 6 decimals).
# Network name and coin are read from get_chain_config at coordinator start-up. There are no webhooks: the coordinator polls query_payment.

# ---------------------------------------------------------------- HSP signed Merchant API (older route, HSP_MODE=api)
# Exact values come from the official HSP manual (hashfans.io) and HashKey. Every default below is
# marked TODO(HSP-DOCS) in packages/core/src/hsp.ts and must be confirmed.
# 1 = "HSP local stand-in" (development only, refused on mainnet)
# merchant API base. QA/testnet: https://merchant-qa.hashkeymerchant.com  (production, mainnet tokens only: https://hsp.hashkey.com)
HSP_BASE_URL=
# payer/checkout API base, if different from HSP_BASE_URL
HSP_PAYER_BASE_URL=
HSP_APP_KEY=
HSP_APP_SECRET=
# ES256K key: PEM text, 0x-hex, or a path to a PEM file. Register its public key with HashKey.
HSP_MERCHANT_PRIVATE_KEY=.hsp/merchant_private_key.pem
# (HSP_MERCHANT_NAME is set above)
# webhook secret defaults to HSP_APP_SECRET (HSP signs webhooks with the app secret)
HSP_WEBHOOK_SECRET=
# Optional overrides of unverified wire details (defaults in packages/core/src/hsp*.ts):
# HSP_PATH_CREATE_ORDER=/api/v1/merchant/orders
# HSP_PATH_PAYMENTS=/api/v1/merchant/payments
# HSP_PATH_CART_BY_FLOW=/api/v1/checkout/orders/{flowId}
# HSP_PATH_PAY_MANDATE=/api/v1/payment/pay-mandate
# HSP_HEADER_APP_KEY=X-App-Key
# HSP_HEADER_TIMESTAMP=X-Timestamp
# HSP_HEADER_NONCE=X-Nonce
# HSP_HEADER_SIGNATURE=X-Signature
# HSP_HEADER_WEBHOOK_SIGNATURE=X-Signature
# HSP_JWT_AUDIENCE=HashkeyMerchant
# HSP_X402_METHOD=https://www.x402.org/
# HSP_NETWORK_NAME=hashkey-testnet
# HSP_COIN=USDC
# HSP_WEBHOOK_EVENT_ID_FIELD=request_id
# HSP_SUCCESS_STATUSES=payment-included,payment-safe,payment-finalized
# HSP_FAILED_STATUSES=payment-failed
# HSP local stand-in only:
# HSP_STANDIN_URL=http://127.0.0.1:7301
# HSP_STANDIN_RELAYER_PRIVATE_KEY=
# ROGUE_HSP_APP_KEY= / ROGUE_HSP_APP_SECRET= / ROGUE_HSP_MERCHANT_PRIVATE_KEY=   (rogue's own merchant account, for the cart-swap demo)

# ---------------------------------------------------------------- vault
# uncompressed secp256k1 public key (0x04...)
AUDITOR_PUBLIC_KEY=
# the user's token: seal / revoke / rotate / status
VAULT_ADMIN_TOKEN=
# the buyer agent's token: negotiation, proof, voucher only
VAULT_AGENT_TOKEN=
VAULT_GLOBAL_PROBE_LIMIT=40
VAULT_PER_SELLER_NEGOTIATIONS=3
VAULT_SELLER_COOLDOWN_MS=30000
VAULT_RESPONSE_DELAY_MS=1500
VAULT_SESSION_SECONDS=3600
VAULT_AUTO_ROTATE=1

# ---------------------------------------------------------------- services
COORDINATOR_PORT=7201
COORDINATOR_POLL_MS=3000
VAULT_PORT=7001
BUYER_AGENT_PORT=7002
SELLER_URLS=http://127.0.0.1:7101,http://127.0.0.1:7102,http://127.0.0.1:7103
# tokenized-asset contracts the sellers' data products describe
DATA_ASSETS=

# ---------------------------------------------------------------- llm
# Anthropic API key for the buyer agent (claude-opus-5-5)
LLM_API_KEY=
