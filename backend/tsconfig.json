{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@sealed/core": ["packages/core/src/index.ts"],
      "@sealed/prover": ["packages/prover/src/index.ts"],
      "vitest": ["node_modules/vitest"],
      "viem": ["node_modules/viem"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "packages/*/scripts", "services/*/src", "services/*/test", "tests", "scripts/*.ts", "../circuits/test"]
}
